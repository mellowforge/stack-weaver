{
  "name": "@stack-weaver/core",
  "version": "0.1.0",
  "description": "Framework-agnostic, schema-driven visual and code editor core for Kubernetes and docker-compose YAML.",
  "license": "MIT",
  "author": "Konstantin Penzin",
  "homepage": "https://github.com/Constantine-24/stack-weaver#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Constantine-24/stack-weaver.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Constantine-24/stack-weaver/issues"
  },
  "keywords": [
    "kubernetes",
    "docker-compose",
    "yaml",
    "editor",
    "schema",
    "framework-agnostic",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./formats/kubernetes": {
      "types": "./dist/formats/kubernetes/index.d.ts",
      "import": "./dist/formats/kubernetes/index.js"
    },
    "./formats/compose": {
      "types": "./dist/formats/compose/index.d.ts",
      "import": "./dist/formats/compose/index.js"
    },
    "./editors/codemirror": {
      "types": "./dist/editors/codemirror/index.d.ts",
      "import": "./dist/editors/codemirror/index.js"
    },
    "./stack-weaver.css": "./dist/stack-weaver.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prebuild": "node scripts/gen-version.mjs && node scripts/gen-kubernetes.mjs && node scripts/gen-compose.mjs",
    "build": "node scripts/copy-generated.mjs && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "pretest": "node scripts/gen-version.mjs && node scripts/gen-kubernetes.mjs && node scripts/gen-compose.mjs",
    "test": "vitest run",
    "pretypecheck": "node scripts/gen-version.mjs && node scripts/gen-kubernetes.mjs && node scripts/gen-compose.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
